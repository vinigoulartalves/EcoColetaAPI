{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "status",
    "database",
    "environment",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "Healthy"
      ]
    },
    "database": {
      "type": "string",
      "enum": [
        "Connected"
      ]
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  }
}
