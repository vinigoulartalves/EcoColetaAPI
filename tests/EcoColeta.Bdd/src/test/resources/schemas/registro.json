{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "id",
    "pontoColetaId",
    "nomePontoColeta",
    "tipoResiduo",
    "pesoKg",
    "origem",
    "observacao",
    "registradoEm"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "pontoColetaId": {
      "type": "integer",
      "minimum": 1
    },
    "nomePontoColeta": {
      "type": "string",
      "minLength": 1
    },
    "tipoResiduo": {
      "type": "string",
      "enum": [
        "Plastico",
        "Papel",
        "Vidro",
        "Metal",
        "Organico",
        "Eletronico",
        "PilhasBaterias",
        "OleoCozinha",
        "Outros"
      ]
    },
    "pesoKg": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 10000
    },
    "origem": {
      "type": "string",
      "minLength": 1
    },
    "observacao": {
      "type": [
        "string",
        "null"
      ]
    },
    "registradoEm": {
      "type": "string",
      "format": "date-time"
    }
  }
}
